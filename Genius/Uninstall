PATH=/usr/bin:/bin
set -o errexit
set -o nounset
set -o pipefail
set -o privileged

if [[ $0 != */Genius.app/Contents/Resources/Uninstall ]]; then
	exit 1
fi

cd "$(dirname "$0")/../../.."

while ps aux -c | grep --word-regexp --fixed-strings Genius > /dev/null; do
	sleep 0.1
done

set +o errexit

rm -R -f Genius.app

for home_directory in /Users/*/; do
	rm -f "$home_directory"Library/Application\ Support/CrashReporter/Genius_*.plist
	rm -R -f "$home_directory"Library/Caches/dev.F1248.Genius
	rm -R -f "$home_directory"Library/HTTPStorages/dev.F1248.Genius
	rm -f "$home_directory"Library/Logs/DiagnosticReports/Genius-*-*-*-*.ips
	defaults delete "$home_directory"Library/Preferences/dev.F1248.Genius.plist
	rm -f "$home_directory"Library/Preferences/dev.F1248.Genius.plist
done
